{
  "name": "@edu/web",
  "version": "0.1.0",
  "private": true,
  "description": "Мини-приложение дополнительного образования в MAX: ученик, родитель, преподаватель (React SPA, WebView)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@edu/contracts": "workspace:*",
    "@edu/ui": "workspace:*",
    "@tanstack/react-query": "^5.80.0",
    "@ts-rest/core": "~3.52.1",
    "i18next": "^25.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.0.0",
    "react-router": "^7.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@edu/config": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "jsdom": "^26.1.0",
    "msw": "^2.7.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
