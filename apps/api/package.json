{
  "name": "@edu/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend: HTTP-процесс (main.ts) и worker (worker.ts) на одном коде",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:watch": "dotenv -e ../../.env -- vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@edu/ai": "workspace:*",
    "@edu/contracts": "workspace:*",
    "@edu/db": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-express": "^11.1.0",
    "@ts-rest/core": "~3.52.1",
    "@ts-rest/nest": "~3.52.1",
    "@vercel/functions": "^2.2.13",
    "bullmq": "^5.56.0",
    "dotenv": "^16.5.0",
    "mammoth": "1.9.1",
    "pdf-parse": "1.1.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@edu/config": "workspace:*",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.12.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pdf-parse": "1.1.5",
    "@types/supertest": "^6.0.3",
    "@vercel/node": "^5.10.2",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.30.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.1",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.4"
  }
}
