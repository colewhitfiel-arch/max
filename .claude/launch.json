{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:CORS_ORIGINS='http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176'; pnpm --filter @edu/api dev"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "if (-not $env:PORT) { $env:PORT = 5173 }; pnpm --filter @edu/web exec vite --host 127.0.0.1 --port $env:PORT --strictPort"
      ],
      "port": 5173,
      "autoPort": true,
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "web-2",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "if (-not $env:PORT) { $env:PORT = 5174 }; pnpm --filter @edu/web exec vite --host 127.0.0.1 --port $env:PORT --strictPort"
      ],
      "port": 5174,
      "autoPort": true,
      "url": "http://127.0.0.1:5174"
    },
    {
      "name": "web-3",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "if (-not $env:PORT) { $env:PORT = 5176 }; pnpm --filter @edu/web exec vite --host 127.0.0.1 --port $env:PORT --strictPort"
      ],
      "port": 5176,
      "autoPort": true,
      "url": "http://127.0.0.1:5176"
    }
  ]
}
