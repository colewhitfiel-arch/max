// groups + schedule: группы, зачисления, правила расписания, занятия. Владелец — B2.

model Group {
  id          String   @id @default(uuid(7)) @db.Uuid
  clubId      String   @map("club_id") @db.Uuid
  teacherId   String   @map("teacher_id") @db.Uuid
  title       String
  isActive    Boolean  @default(true) @map("is_active")
  /// Токен многоразовой ссылки-приглашения (/join/:token); null — ещё не выдавалась
  inviteToken String?  @unique @map("invite_token")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  club    Club           @relation(fields: [clubId], references: [id])
  teacher TeacherProfile @relation(fields: [teacherId], references: [id])

  enrollments    Enrollment[]
  scheduleRules  ScheduleRule[]
  lessons        Lesson[]
  courses        Course[]
  assignments    Assignment[]
  generationJobs CourseGenerationJob[]
  walletLedger   TeacherWalletTransaction[]

  @@index([teacherId])
  @@index([clubId])
  @@map("groups")
}

model Enrollment {
  id         String           @id @default(uuid(7)) @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  groupId    String           @map("group_id") @db.Uuid
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz
  leftAt     DateTime?        @map("left_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  student StudentProfile @relation(fields: [studentId], references: [id])
  group   Group          @relation(fields: [groupId], references: [id])

  paidPeriods PaidPeriod[]
  payments    Payment[]

  @@unique([studentId, groupId])
  @@index([groupId, status])
  @@map("enrollments")
}

model ScheduleRule {
  id        String    @id @default(uuid(7)) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  /// 0 — воскресенье … 6 — суббота
  weekday   Int
  /// "HH:mm" в часовом поясе школы
  startTime String    @map("start_time")
  endTime   String    @map("end_time")
  room      String?
  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([groupId])
  @@map("schedule_rules")
}

model Lesson {
  id           String       @id @default(uuid(7)) @db.Uuid
  groupId      String       @map("group_id") @db.Uuid
  ruleId       String?      @map("rule_id") @db.Uuid
  startsAt     DateTime     @map("starts_at") @db.Timestamptz
  endsAt       DateTime     @map("ends_at") @db.Timestamptz
  topic        String?
  room         String?
  status       LessonStatus @default(PLANNED)
  cancelReason String?      @map("cancel_reason")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  group Group         @relation(fields: [groupId], references: [id])
  rule  ScheduleRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  attendance Attendance[]

  @@unique([ruleId, startsAt])
  @@index([groupId, startsAt])
  @@index([startsAt])
  @@map("lessons")
}
