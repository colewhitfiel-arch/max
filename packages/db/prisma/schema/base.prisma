// Базовый файл схемы: datasource, generator, все enum'ы, User, AuditLog.
// Владелец — db (docs/10-ownership.md §10.3). Enum'ы должны совпадать 1:1 с
// packages/contracts/src/enums.ts и docs/04-data-model.md §4.1.
// Остальные модели — в файлах по модулям в этой же папке (multi-file schema).

generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/client"
  // native — локальная разработка; rhel-openssl-3.0.x — Vercel Functions (Amazon Linux 2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

