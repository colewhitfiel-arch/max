// family: привязка родитель ↔ ребёнок. Владелец — B8.

model ParentStudentLink {
  parentId    String     @map("parent_id") @db.Uuid
  studentId   String     @map("student_id") @db.Uuid
  status      LinkStatus @default(ACTIVE)
  requestedAt DateTime   @default(now()) @map("requested_at") @db.Timestamptz
  confirmedAt DateTime?  @map("confirmed_at") @db.Timestamptz
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId])
  @@map("parent_student_links")
}

/// Ссылка-приглашение ребёнка: родитель создаёт, ребёнок открывает и принимает.
model ParentInvite {
  token      String    @id
  parentId   String    @map("parent_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  acceptedBy String?   @map("accepted_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  parent ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, createdAt])
  @@map("parent_invites")
}
