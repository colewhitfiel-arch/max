{
  "name": "@edu/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Единственный источник типов API: zod-схемы, ts-rest контракты, enum'ы, события, permissions, фикстуры",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fixtures": {
      "import": {
        "types": "./dist/fixtures/index.d.ts",
        "default": "./dist/fixtures/index.js"
      },
      "require": {
        "types": "./dist/fixtures/index.d.cts",
        "default": "./dist/fixtures/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "openapi": "tsx scripts/openapi.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ts-rest/core": "~3.52.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@edu/config": "workspace:*",
    "@ts-rest/open-api": "~3.52.1",
    "eslint": "^9.30.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
