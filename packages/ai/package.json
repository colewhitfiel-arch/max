{
  "name": "@edu/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Слой ИИ: порт LlmProvider, адаптер GigaChat, mock-провайдер, реестр промптов, JSON-парсинг, сериализация StudentContext",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "undici": "^7.29.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@edu/config": "workspace:*",
    "@types/node": "^22.20.4",
    "eslint": "^9.30.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
