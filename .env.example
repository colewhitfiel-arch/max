# ===========================================================================
# Единый .env для всего монорепо (api, worker, prisma, web).
# Скопируй в .env и поправь под себя. Секреты — только здесь или в secret manager.
# Обязательность переменных проверяется на старте api (apps/api/src/config/env.ts).
# ===========================================================================

# --- Общее ------------------------------------------------------------------
# NODE_ENV здесь не задаётся: api по умолчанию считает его development (env.ts), тесты — test.
# Vite читает этот .env (envDir — корень), и NODE_ENV=development из файла превращает
# `vite build` в dev-сборку (import.meta.env.DEV=true). Нужен другой — задавай в shell/деплое.
# NODE_ENV=development
# development | staging | production — влияет на дефолты и строгость проверок
APP_ENV=development
LOG_LEVEL=debug

# --- Backend -----------------------------------------------------------------
API_PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
# Через запятую. В production обязателен явный список. Пусто: в development — любой origin,
# в staging — CORS выключен (web и api на одном origin: Vercel, nginx из compose.yaml).
CORS_ORIGINS=http://localhost:5173

# --- База данных (PostgreSQL) -----------------------------------------------
# Локально: `pnpm db:up` поднимает embedded PostgreSQL на этом порту (без Docker).
# Если есть Docker: `docker compose -f infra/docker-compose.yml up -d`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edu?schema=public
# Для интеграционных тестов api (отдельная БД, создаётся автоматически)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/edu_test?schema=public
# SKIP_DB_TESTS=1 — пропустить тесты, которым нужна БД (packages/db, интеграционные api)

# --- Очереди / кэш ---------------------------------------------------------
# inline — задачи выполняются в процессе api (dev без Redis); bullmq — через Redis
QUEUE_DRIVER=inline
# Обязателен при QUEUE_DRIVER=bullmq. С infra/docker-compose.yml: redis://localhost:6379
REDIS_URL=
# memory — key-value в памяти процесса (dev); postgres — таблица kv_entries, общая для всех
# инстансов (обязательно на serverless: идемпотентность, дневные лимиты, кэш контекста)
KV_DRIVER=memory

# --- Лимиты частоты запросов (429 RATE_LIMITED; счётчики — в KV_DRIVER) ------
# Пусто — включено везде, кроме NODE_ENV=test; 0 — выключить. IP клиента — последний адрес
# X-Forwarded-For: его дописывает infra/nginx.conf (за доверенным прокси — настоящего клиента,
# realip), Vercel ставит сам. TLS-прокси перед стендом должен передавать X-Forwarded-For —
# иначе у всех клиентов один счётчик входа (README, «Хостинг»).
RATE_LIMIT_ENABLED=
# Входов и обновлений сессии (/auth/max, /auth/dev, /auth/refresh) в минуту с одного IP
RATE_LIMIT_AUTH_PER_MIN=60
# Попыток привязать ребёнка по коду и принять приглашение в час на пользователя
RATE_LIMIT_LINK_PER_HOUR=10
# Запросов к ИИ (тьютор, онбординг) в минуту на пользователя
RATE_LIMIT_AI_PER_MIN=20
# Запусков генерации курса (course-builder: одна задача — много вызовов GigaChat) в час на пользователя
RATE_LIMIT_GENERATION_PER_HOUR=10

# --- Аутентификация ----------------------------------------------------------
# dev — POST /auth/dev, быстрое переключение ролей; max — проверка launch-параметров MAX
AUTH_PROVIDER=dev
# Минимум 32 символа. Вне development (staging, production) api не стартует с этим dev-значением.
JWT_SECRET=dev-only-secret-change-me-please-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- MAX (мини-приложение) --------------------------------------------------
# MAX_BOT_TOKEN обязателен при AUTH_PROVIDER=max; MAX_APP_ID пока не используется
# (зарезервирован). Уточнить в dev.max.ru.
MAX_APP_ID=
# Токен бота MAX (им подписаны launch-параметры мини-приложения). Обязателен при AUTH_PROVIDER=max
MAX_BOT_TOKEN=
# 1 — при неверной подписи писать в лог разбор: какой вариант схемы совпал бы, длину токена и его
# отпечаток (первые 8 hex sha256). Только для отладки расхождения подписи; по умолчанию выключено.
MAX_AUTH_DEBUG=
# Имя бота MAX из ссылки https://max.ru/<имя> (без @). Нужно, чтобы ссылка-приглашение ребёнка
# открывалась прямо в мини-приложении: https://max.ru/<имя>?startapp=invite_<токен>. Пусто —
# ссылка ведёт на WEB_URL/invite/<токен> (годится для браузера, но не для входа через MAX).
MAX_BOT_NAME=

# --- GigaChat ---------------------------------------------------------------
# mock — детерминированные ответы без сети; gigachat — реальный API.
# В production mock запрещён (api не стартует).
AI_PROVIDER=mock
# Authorization key из личного кабинета Sber (base64 client_id:client_secret)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_TIMEOUT_MS=30000
GIGACHAT_MAX_RETRIES=3
# Одновременных запросов к GigaChat. Персональный тариф (GIGACHAT_API_PERS) принимает один
# запрос за раз, иначе 429; на B2B/CORP можно поднять — параллельность пайплайнов упирается сюда.
GIGACHAT_MAX_CONCURRENCY=1
# Путь к корневому сертификату НУЦ Минцифры (pem). Пусто — системные CA.
# Системные CA НЕ подходят (SELF_SIGNED_CERT_IN_CHAIN) — сертификат обязателен.
GIGACHAT_CA_CERT_PATH=
# Тот же сертификат в base64 — для сред без диска (Vercel): api сам запишет его в /tmp
# и подставит в GIGACHAT_CA_CERT_PATH. Получить: base64 -i gigachat-ca.pem | tr -d '\n'
GIGACHAT_CA_CERT_B64=
# Лимит сообщений ИИ-тьютору на пользователя в сутки (429 при превышении)
AI_TUTOR_DAILY_LIMIT=50
# Параллельность course-builder: сколько окон материала / уроков генерируется одновременно
COURSE_BUILDER_MAX_PARALLEL=3
# Задача генерации без прогресса дольше стольких секунд считается оборванной (→ FAILED).
# На Vercel — чуть больше maxDuration функции (300 с): 360
COURSE_BUILDER_STALE_AFTER_SEC=1800

# --- Хранилище файлов --------------------------------------------------------
# local — файлы в STORAGE_LOCAL_DIR, раздаются api; s3 — S3-совместимое хранилище
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# С infra/docker-compose.yml (MinIO): S3_ENDPOINT=http://localhost:9000, ключи minio / minio12345
# Подходит любое S3-совместимое: Yandex Object Storage, VK Cloud, Supabase Storage, Cloudflare R2.
# Клиент кладёт/читает файлы по presigned URL напрямую — бакету нужен CORS на PUT/GET с origin приложения.
S3_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- Платежи ------------------------------------------------------------------
# fake — платёж закрывается сразу, без денег (только dev); yookassa — реальный провайдер.
# В production fake запрещён (api не стартует).
PAYMENT_PROVIDER=fake
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Frontend (в клиент попадают только VITE_*; NODE_ENV — см. «Общее») -------
VITE_API_URL=http://localhost:3000/api/v1
# mock — эмуляция MAX Bridge в браузере; real — реальный SDK внутри MAX
VITE_MAX_MODE=mock
# dev — экран выбора роли/пользователя; max — вход по launch-параметрам;
# auto — по контексту: внутри MAX подпись, в браузере dev-экран (один адрес работает везде)
VITE_AUTH_MODE=auto
# Чат поддержки в MAX для кнопки «Поддержка» в настройках ученика, родителя и преподавателя:
# https://max.ru/<ник чата или бота>
# (внутри MAX открывается без выхода из мессенджера). Пусто — кнопка сообщает, что чат не подключён.
VITE_SUPPORT_URL=
